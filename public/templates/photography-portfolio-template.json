{
    "templateId": "photography-portfolio-v1",
    "templateName": "Photography Portfolio",
    "templateDescription": "A bold, professional photography portfolio template featuring warm terracotta tones, elegant brush script typography, and dynamic photo collage layouts perfect for photographers, studios, and creative professionals showcasing their work.",
    "version": "1.0.0",
    "category": "portfolio",
    "tags": [
        "photography",
        "portfolio",
        "studio",
        "professional",
        "creative",
        "modern",
        "warm",
        "elegant"
    ],
    "minPhotos": 15,
    "maxPhotos": 80,
    "recommendedPhotos": 40,
    "designSystem": {
        "colors": {
            "background": "#BD8465",
            "backgroundAlt": "#B27555",
            "accent": "#FFFFFF",
            "text": {
                "primary": "#FFFFFF",
                "secondary": "rgba(255,255,255,0.85)",
                "light": "rgba(255,255,255,0.7)"
            }
        },
        "typography": {
            "script": {
                "family": "Allura",
                "fallback": "Pacifico, Satisfy, cursive",
                "weights": [
                    400
                ],
                "usage": "titles, category names, decorative headings"
            },
            "sans": {
                "family": "Poppins",
                "fallback": "Montserrat, Open Sans, sans-serif",
                "weights": [
                    300,
                    400,
                    500,
                    600,
                    700
                ],
                "usage": "subtitles, body text, labels, navigation"
            }
        },
        "spacing": {
            "pagePadding": "4%",
            "photoGap": "2%",
            "textMargin": "5%",
            "headerHeight": "8%"
        },
        "photoStyles": {
            "default": {
                "borderRadius": "0px",
                "shadow": "none",
                "border": "none"
            },
            "rounded": {
                "borderRadius": "8px",
                "shadow": "0 4px 20px rgba(0,0,0,0.15)",
                "border": "none"
            },
            "pill": {
                "borderRadius": "100px",
                "shadow": "none",
                "border": "none"
            }
        }
    },
    "headerFooter": {
        "header": {
            "enabled": true,
            "height": "8%",
            "elements": [
                {
                    "type": "studioName",
                    "position": "left",
                    "style": {
                        "font": "sans",
                        "size": "14px",
                        "weight": 400,
                        "color": "primary"
                    },
                    "placeholder": "Studio Name"
                },
                {
                    "type": "year",
                    "position": "right",
                    "style": {
                        "font": "sans",
                        "size": "14px",
                        "weight": 400,
                        "color": "primary"
                    },
                    "placeholder": "2024"
                }
            ]
        },
        "footer": {
            "enabled": false
        }
    },
