{
    "templateId": "romantic-journey-v1",
    "templateName": "Romantic Journey",
    "templateDescription": "An elegant couple/wedding album template featuring warm earth tones, script typography, and sophisticated layouts perfect for engagement, wedding, and anniversary albums.",
    "version": "1.0.0",
    "category": "wedding",
    "tags": [
        "romantic",
        "wedding",
        "couples",
        "engagement",
        "anniversary",
        "elegant"
    ],
    "minPhotos": 20,
    "maxPhotos": 60,
    "recommendedPhotos": 35,
    "designSystem": {
        "colors": {
            "background": "#EDE8E3",
            "backgroundAlt": "#F5F2EF",
            "accent": "#C4956A",
            "accentDark": "#B07D4F",
            "text": {
                "primary": "#2D2926",
                "secondary": "#5A5552",
                "light": "#8A8583"
            }
        },
        "typography": {
            "script": {
                "family": "Pinyon Script",
                "fallback": "Great Vibes, cursive",
                "weights": [
                    400
                ],
                "usage": "titles, headings, decorative text"
            },
            "serif": {
                "family": "Cormorant Garamond",
                "fallback": "Playfair Display, Georgia, serif",
                "weights": [
                    400,
                    500,
                    600
                ],
                "usage": "subtitles, dates, body text"
            },
            "sans": {
                "family": "Montserrat",
                "fallback": "Open Sans, sans-serif",
                "weights": [
                    400,
                    500,
                    600,
                    700
                ],
                "usage": "UI elements, small caps"
            }
        },
        "spacing": {
            "pagePadding": "5%",
            "photoGap": "2%",
            "textMargin": "4%"
        },
        "photoStyles": {
            "default": {
                "borderRadius": "0px",
                "shadow": "0 4px 20px rgba(0,0,0,0.1)",
                "border": "none"
            },
            "rounded": {
                "borderRadius": "8px",
                "shadow": "0 4px 20px rgba(0,0,0,0.1)",
                "border": "none"
            }
        }
    },
    "decorativeElements": {
        "accentRectangle": {
            "type": "rectangle",
            "color": "#C4956A",
            "sizes": {
                "small": {
                    "width": "8%",
                    "height": "15%"
                },
                "medium": {
                    "width": "10%",
                    "height": "25%"
                },
                "large": {
                    "width": "12%",
                    "height": "35%"
                }
            }
        },
        "accentBar": {
            "type": "rectangle",
            "color": "#C4956A",
            "height": "8%",
            "width": "100%"
        },
        "underline": {
            "type": "line",
            "color": "#2D2926",
            "thickness": "1px",
            "style": "solid"
        }
    },
